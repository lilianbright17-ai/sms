<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { title: 'Create account' }) %></head>
<body>
  <div class="auth-shell">
    <div class="card auth-card">
      <div class="brand"><span class="dot"></span> SignalDesk</div>
      <h1>Create your account</h1>
      <% if (error) { %><div class="error-box"><%= error %></div><% } %>
      <form method="POST" action="/register">
        <div class="field">
          <label for="email">Email</label>
          <input type="email" name="email" id="email" required autofocus />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" name="password" id="password" required minlength="6" />
        </div>
        <div class="field">
          <label for="confirm">Confirm password</label>
          <input type="password" name="confirm" id="confirm" required minlength="6" />
        </div>
        <button class="btn btn-block" type="submit">Create account</button>
      </form>
      <div class="auth-switch">Already have an account? <a href="/login">Log in</a></div>
    </div>
  </div>
</body>
</html>
