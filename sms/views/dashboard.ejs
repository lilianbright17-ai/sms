<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { title: 'Dashboard' }) %></head>
<body>
<div class="app-shell">
  <%- include('partials/nav', { active: 'dashboard' }) %>
  <div class="main">
    <% if (mock) { %>
      <div class="mock-banner">Mock mode is on — numbers and OTPs below are fake sample data. Add a HEROSMS_API_KEY and set MOCK_MODE=false in .env to go live.</div>
    <% } %>
    <div class="page-head">
      <h1>Dashboard</h1>
      <p>Your account at a glance.</p>
    </div>

    <div class="grid grid-3" style="margin-bottom:24px;">
      <div class="card stat-card">
        <div class="stat-label">Wallet balance</div>
        <div class="stat-value"><%= formatMoney(user.balance_cents) %></div>
      </div>
      <div class="card stat-card">
        <div class="stat-label">Orders placed</div>
        <div class="stat-value"><%= orders.length %></div>
      </div>
      <div class="card stat-card">
        <div class="stat-label">Quick action</div>
        <div style="margin-top:6px;"><a class="btn" href="/buy">Buy a number →</a></div>
      </div>
    </div>

    <div class="card">
      <h2 style="margin-bottom:14px;">Recent orders</h2>
      <% if (orders.length === 0) { %>
        <p class="helper-text">No orders yet. <a href="/buy">Buy your first number</a>.</p>
      <% } else { %>
        <table>
          <thead><tr><th>Service</th><th>Country</th><th>Number</th><th>Cost</th><th>Status</th><th></th></tr></thead>
          <tbody>
          <% orders.forEach(o => { %>
            <tr>
              <td><%= o.service_name %></td>
              <td><%= o.country_name %></td>
              <td class="mono"><%= o.phone_number %></td>
              <td><%= formatMoney(o.cost_cents) %></td>
              <td><span class="badge badge-<%= o.status %>"><%= o.status %></span></td>
              <td><a href="/orders/<%= o.id %>">View →</a></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>
</body>
</html>
