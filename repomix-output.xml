<file path="sms/views/register.ejs">
<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { title: 'Create account' }) %></head>
<body>
  <div class="auth-shell">
    <div class="card auth-card">
      <div class="brand"><span class="dot"></span> SignalDesk</div>
      <h1>Create your account</h1>
      <% if (error) { %><div class="error-box"><%= error %></div><% } %>
      <form method="POST" action="/register">
        <div class="field">
          <label for="email">Email</label>
          <input type="email" name="email" id="email" required autofocus />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" name="password" id="password" required minlength="6" />
        </div>
        <div class="field">
          <label for="confirm">Confirm password</label>
          <input type="password" name="confirm" id="confirm" required minlength="6" />
        </div>
        <button class="btn btn-block" type="submit">Create account</button>
      </form>
      <div class="auth-switch">Already have an account? <a href="/login">Log in</a></div>
    </div>
  </div>
</body>
</html>
</file>

<file path="sms/views/wallet.ejs">
<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { title: 'Wallet' }) %></head>
<body>
<div class="app-shell">
  <%- include('partials/nav', { active: 'wallet' }) %>
  <div class="main">
    <div class="page-head">
      <h1>Wallet</h1>
      <p>Your balance and transaction history.</p>
    </div>

    <div class="grid grid-2" style="margin-bottom:24px;">
      <div class="card stat-card">
        <div class="stat-label">Current balance</div>
        <div class="stat-value"><%= formatMoney(user.balance_cents) %></div>
      </div>
      <div class="card">
        <h2 style="font-size:1rem;">Add funds</h2>
        <p class="helper-text" style="margin-bottom:12px;">To add funds to your wallet, please contact support to arrange payment. Your balance will be credited once payment is confirmed.</p>
      </div>
    </div>

    <div class="card">
      <h2 style="margin-bottom:14px;">Transaction history</h2>
      <% if (txs.length === 0) { %>
        <p class="helper-text">No transactions yet.</p>
      <% } else { %>
        <table>
          <thead><tr><th>Date</th><th>Reason</th><th>Amount</th></tr></thead>
          <tbody>
          <% txs.forEach(t => { %>
            <tr>
              <td class="helper-text"><%= t.created_at %></td>
              <td><%= t.reason %></td>
              <td class="mono" style="color: <%= t.amount_cents >= 0 ? 'var(--signal)' : 'var(--danger)' %>">
                <%= t.amount_cents >= 0 ? '+' : '' %><%= formatMoney(t.amount_cents) %>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>
</body>
</html>
</file>

