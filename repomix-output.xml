/* ---- Auth pages ---- */
.auth-shell {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    repeating-linear-gradient(0deg, rgba(51,230,160,0.025) 0px, transparent 1px, transparent 40px),
    repeating-linear-gradient(90deg, rgba(51,230,160,0.025) 0px, transparent 1px, transparent 40px),
    radial-gradient(circle at 50% -10%, rgba(51,230,160,0.08), transparent 55%),
