.auth-card { width: 370px; }
.auth-card .brand { justify-content: center; margin-bottom: 20px; font-size: 1.35rem; }
.auth-card h1 { text-align: center; font-size: 1.2rem; }
.auth-switch { text-align: center; margin-top: 15px; color: var(--text-dim); font-size: 0.88rem; }

/* ---- Order / signal panel ---- */
.signal-panel {
  border: 1px dashed var(--border);
  border-radius: var(--radius);
  padding: 26px;
  text-align: center;
  margin: 18px 0;
}
.signal-panel .scanning { color: var(--text-dim); font-size: 0.85rem; letter-spacing: 0.01em; }

/* Reception-bars loading indicator, replacing a generic sweep */
.signal-panel .scan-bar {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 5px;
  height: 28px;
  margin: 18px 0 4px;
}
.signal-panel .scan-bar span {
  display: block;
  width: 5px;
  border-radius: 3px;
  background: var(--signal);
  animation: bars 1.1s ease-in-out infinite;
}
.signal-panel .scan-bar span:nth-child(1) { height: 30%; animation-delay: 0s; }
.signal-panel .scan-bar::before,
.signal-panel .scan-bar::after {
