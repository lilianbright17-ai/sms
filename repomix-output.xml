@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap');

:root {
  --bg: #0a100d;
  --bg-raised: #121b16;
  --bg-input: #16211b;
  --border: #24352c;
  --border-soft: rgba(255,255,255,0.05);
  --text: #ecf3ee;
  --text-dim: #8fa89b;
  --signal: #33e6a0;
  --signal-dim: #163826;
  --naira: #f5b900;
  --naira-dim: #4a3a08;
  --danger: #ff5c5c;
  --radius-sm: 8px;
  --radius: 12px;
  --radius-lg: 18px;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background:
    radial-gradient(circle at 15% 0%, rgba(51,230,160,0.05), transparent 45%),
    radial-gradient(circle at 100% 100%, rgba(245,185,0,0.04), transparent 40%),
    var(--bg);
  color: var(--text);
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 15px;
  line-height: 1.5;
}

h1, h2, h3, .display {
  font-family: 'Space Grotesk', system-ui, sans-serif;
  font-weight: 600;
  letter-spacing: -0.01em;
  margin: 0 0 0.4em;
}

.mono, .phone, .otp-code, .otp-display, .phone-display, code {
  font-family: 'Space Mono', ui-monospace, monospace;
}

a { color: var(--signal); text-decoration: none; }
a:hover { text-decoration: underline; }

.app-shell {
  display: flex;
  min-height: 100vh;
}

/* ---- Sidebar ---- */
.sidebar {
  width: 224px;
  flex-shrink: 0;
  background: var(--bg-raised);
  border-right: 1px solid var(--border);
  padding: 24px 16px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 700;
  font-size: 1.15rem;
  color: var(--text);
  letter-spacing: -0.01em;
}

.brand .dot {
  position: relative;
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--signal);
  box-shadow: 0 0 6px var(--signal);
}
.brand .dot::before,
.brand .dot::after {
  content: '';
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  border: 1px solid var(--signal);
  opacity: 0;
  animation: ping 2.4s ease-out infinite;
}
.brand .dot::after { animation-delay: 1.2s; }
@keyframes ping {
  0% { transform: scale(0.6); opacity: 0.7; }
  100% { transform: scale(2.6); opacity: 0; }
}

.nav-links { display: flex; flex-direction: column; gap: 2px; }

.nav-links a {
  color: var(--text-dim);
  padding: 9px 11px;
  border-radius: var(--radius-sm);
  font-size: 0.92rem;
  transition: background 0.15s ease, color 0.15s ease;
}

.nav-links a:hover { background: var(--bg-input); text-decoration: none; color: var(--text); }
.nav-links a.active { background: var(--signal-dim); color: var(--signal); font-weight: 500; }

.sidebar-footer { margin-top: auto; }

.balance-chip {
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-top: 1px solid var(--border-soft);
  border-radius: var(--radius);
  padding: 13px 14px;
}
.balance-chip .label { color: var(--text-dim); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.07em; }
.balance-chip .amount { font-family: 'Space Mono', monospace; font-weight: 700; font-size: 1.35rem; color: var(--naira); margin-top: 3px; }

/* ---- Main content ---- */
.main { flex: 1; padding: 34px 42px; max-width: 1000px; }

